{
  "manifest_version": 3,
  "name": "Web to Kindle - Reader Mode Ebook Sender",
  "version": "1.0.0",
  "description": "Extract any website in clean reader mode as a Kindle-compatible EPUB ebook and send it to your Kindle email.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Send to Kindle",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.min.js",
        "lib/pdf.min.js",
        "lib/jszip.min.js",
        "lib/readability.js",
        "lib/book-crawler.js",
        "content/extractor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "send-to-kindle": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Send active tab in reader mode to Kindle"
    }
  }
}
